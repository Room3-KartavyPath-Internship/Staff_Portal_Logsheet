package com.sunbeam.logsheet.entity;

import com.fasterxml.jackson.annotation.JsonCreator;
import com.fasterxml.jackson.annotation.JsonValue;

public enum StaffType {
	INHOUSE,
    VISITING;

    // custom method to match case-insensitively
    public static StaffType fromString(String value) {
        for (StaffType type : StaffType.values()) {
            if (type.name().equalsIgnoreCase(value)) {
                return type;
            }
        }
        throw new IllegalArgumentException("Invalid StaffType: " + value);
    }
   

}
