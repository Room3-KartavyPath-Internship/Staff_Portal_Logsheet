package com.sunbeam.logsheet.entity;

public enum StaffType {
//    InHouse,
//    Visiting
	INHOUSE,
    VISITING
  
    @JsonCreator
    public static StaffType fromValue(String value) {
        if (value == null) return null;
        return StaffType.valueOf(value.toUpperCase().replace("_", ""));
    }

}
