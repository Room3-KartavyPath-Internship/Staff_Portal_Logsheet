package com.sunbeam.logsheet.entity;

import com.fasterxml.jackson.annotation.JsonCreator;

public enum StaffType {
	INHOUSE("InHouse"),
    VISITING("Visiting");

    private final String value;

    StaffType(String value) {
        this.value = value;
    }

    @JsonValue
    public String getValue() {
        return value;
    }

    @JsonCreator
    public static StaffType fromValue(String value) {
        for (StaffType type : StaffType.values()) {
            if (type.value.equalsIgnoreCase(value)) {
                return type;
            }
        }
        throw new IllegalArgumentException("Invalid StaffType: " + value);
    }
   

}
